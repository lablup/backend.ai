[Unit]
Description=Backend.AI manager
Requires=backendai-credentials.service backendai-postgresql.service backendai-etcd.service backendai-valkey.service
After=backendai-credentials.service backendai-postgresql.service backendai-etcd.service backendai-valkey.service

[Service]
Type=simple
User=backendai
Group=backendai
LoadCredential=manager.toml:/run/backendai-credentials.sock
LoadCredential=rpc-keypair:/run/backendai-credentials.sock
LoadCredential=tls.key:/run/backendai-credentials.sock
LoadCredential=tls.crt:/run/backendai-credentials.sock
ExecStartPre=/usr/lib/backendai/credential-guard manager.toml rpc-keypair tls.key tls.crt
ExecStart=/usr/lib/backendai/backendai-manager start-server -f ${CREDENTIALS_DIRECTORY}/manager.toml
WorkingDirectory=/var/lib/backendai/manager
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/backendai/manager /run/backendai
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
