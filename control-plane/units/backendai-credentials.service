[Unit]
Description=Backend.AI credential broker
Documentation=https://github.com/lablup/backend.ai
DefaultDependencies=no
After=systemd-remount-fs.service local-fs.target network-online.target
Wants=network-online.target
Conflicts=shutdown.target
Before=shutdown.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -m broker --policy /etc/backendai/credential-policy.toml
Environment=PYTHONPATH=/usr/lib/backendai/credential-broker
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=10
RuntimeDirectory=backendai-credentials
RuntimeDirectoryMode=0700
StateDirectory=backendai
LogsDirectory=backendai
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
