[Unit]
Description=Backend.AI state bundle PostgreSQL role and database bootstrap
Requires=backendai-credentials.service backendai-postgresql.service
After=backendai-credentials.service backendai-postgresql.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=postgres
Group=postgres
LoadCredential=password:/run/backendai-credentials.sock
ExecStart=/usr/lib/backendai/credential-guard password
ExecStart=/usr/lib/backendai/datastore-bootstrap postgres-sync
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ReadWritePaths=/run/backendai
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
