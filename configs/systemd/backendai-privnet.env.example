# Numeric UID of the Backend.AI agent service account allowed to use the socket.
BACKENDAI_PRIVNET_UID=1001

# Must match [agent].id. Use the hostname when the agent id is auto-detected.
BACKENDAI_PRIVNET_AGENT_ID=agent-node-01

# Routable IPv4 address advertised as this node's VXLAN tunnel endpoint.
BACKENDAI_PRIVNET_HOST_IP=192.0.2.10
