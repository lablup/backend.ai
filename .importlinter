[importlinter]
root_package = ai.backend
include_external_packages = False

[importlinter:contract:manager-layers]
name = Manager layer order: api > services > repositories > models
type = layers
layers =
    ai.backend.manager.api
    ai.backend.manager.services
    ai.backend.manager.repositories
    ai.backend.manager.models
ignore_imports =
    ai.backend.manager.models.alembic.versions.592dedb4a39c_put_auto_generated_files_in_the_graph -> ai.backend.manager.cli.role_fixture
    ai.backend.manager.models.alembic.versions.995eabef0eac_revoke_members_read_on_system_session_environ -> ai.backend.manager.cli.role_fixture
    ai.backend.manager.models.alembic.versions.bf07cae92d86_grant_role_presets_on_system_session_environ -> ai.backend.manager.cli.role_fixture

[importlinter:contract:data-layer]
name = manager/data imports no upper layer
type = forbidden
allow_indirect_imports = true
source_modules =
    ai.backend.manager.data
forbidden_modules =
    ai.backend.manager.models
    ai.backend.manager.repositories
    ai.backend.manager.services
    ai.backend.manager.api

[importlinter:contract:common-inward]
name = common imports no component
type = forbidden
allow_indirect_imports = true
source_modules =
    ai.backend.common
forbidden_modules =
    ai.backend.manager
    ai.backend.agent
    ai.backend.storage
    ai.backend.appproxy

[importlinter:contract:component-independence]
name = manager, agent, storage and appproxy are independent
type = independence
modules =
    ai.backend.manager
    ai.backend.agent
    ai.backend.storage
    ai.backend.appproxy
