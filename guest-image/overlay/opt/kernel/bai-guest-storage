#!/opt/backend.ai/bin/python
import ctypes
import json
import mmap
import os
import pathlib
import re
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request

STATE = pathlib.Path("/run/backend.ai")
STAGING = pathlib.Path("/run/bai-storage")
GUEST = pathlib.Path("/run/bai-guest")
SHIMS = pathlib.Path("/run/bai-shims")
LOADER = GUEST / "lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"
LIBRARY_PATH = ":".join([
    f"{GUEST}/lib/x86_64-linux-gnu",
    f"{GUEST}/lib/x86_64-linux-gnu/ceph",
    f"{GUEST}/lib",
])
MAPPER = "bai-scratch"
BLOCK = 4096
HELPERS = {"nfs4": "mount.nfs4", "ceph": "mount.ceph", "cifs": "mount.cifs"}
GOCRYPTFS_FLAGS = ("-raw64", "-hkdf", "-longnames", "-noprealloc", "-allow_other")
CC_STORAGE_FORMAT = "backend.ai/cc-storage/v1"


class Refusal(Exception):
    pass


def tool(name):
    for base in ("sbin", "bin", "local/bin"):
        found = GUEST / base / name
        if found.is_file():
            return str(found)
    raise Refusal(f"the measured guest image delivers no {name} under {GUEST}")


def note(message):
    print(message, file=sys.stderr, flush=True)
    try:
        with open("/dev/console", "w") as console:
            print(message, file=console, flush=True)
    except OSError:
        pass


def run(argv, stdin=None):
    name = pathlib.Path(argv[0]).name
    note(f"backend.ai confidential storage runs {name}")
    launch = [str(LOADER), "--library-path", LIBRARY_PATH, *argv]
    env = {**os.environ, "DM_DISABLE_UDEV": "1"}
    env["PATH"] = SHIMS.as_posix() + ":" + env.get("PATH", "")
    result = subprocess.run(launch, input=stdin, capture_output=True, env=env)
    if result.returncode != 0:
        detail = result.stderr.decode(errors="replace").strip() or f"exit {result.returncode}"
        raise Refusal(f"{name} failed: {detail}")
    return result.stdout.decode(errors="replace")


def node(path, major, minor):
    pathlib.Path(path).parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if not pathlib.Path(path).exists():
        os.mknod(path, 0o600 | stat.S_IFCHR, os.makedev(major, minor))


def kmount(source, target, fstype, flags):
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    if libc.mount(source.encode(), str(target).encode(), fstype.encode(), flags, None) != 0:
        raise Refusal(f"mounting {source} at {target} failed: {os.strerror(ctypes.get_errno())}")


def fetch(api, resource):
    url = f"{api}/cdh/resource/{resource}"
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read()
    except urllib.error.HTTPError as error:
        raise Refusal(f"the broker refused {resource} with {error.code}")
    except OSError as error:
        raise Refusal(f"the broker at {api} was unreachable for {resource}: {error}")
    if not payload:
        raise Refusal(f"the broker released {resource} as zero bytes")
    return payload


def released_key(api, scope, descriptor, subject):
    tag = descriptor.get("key_tag")
    if not tag or "/" in tag:
        raise Refusal(f"{subject} carries an encryption descriptor with no key tag")
    resource = f"{scope}/{tag}"
    key = fetch(api, resource)
    if len(key) != 32:
        raise Refusal(f"the broker released {resource} as {len(key)} bytes, not a folder key")
    return key


def shim_fusermount():
    # gocryptfs execs fusermount3 by name with an environment of exactly _FUSE_COMMFD=3, so
    # neither our loader wrapping nor LD_LIBRARY_PATH reaches it. PATH is the only lever, and
    # what it finds has to stand on its own.
    SHIMS.mkdir(mode=0o755, parents=True, exist_ok=True)
    shim = SHIMS / "fusermount3"
    shim.write_text(
        f'#!/bin/sh\nexec {LOADER} --library-path {LIBRARY_PATH} {tool("fusermount3")} "$@"\n'
    )
    shim.chmod(0o755)


def transport(entry, cipher):
    kind = entry.get("kind")
    if kind == "nfs":
        raise Refusal(
            f"folder {entry['name']} asks for NFSv3, which needs a portmapper this measured"
            " guest does not run; export it as nfs4"
        )
    if kind not in HELPERS:
        raise Refusal(f"folder {entry['name']} names transport {kind!r}, which is not baked in")
    options = [entry["options"]] if entry.get("options") else []
    if entry.get("read_only"):
        options.append("ro")
    argv = [tool(HELPERS[kind]), entry["source"], str(cipher)]
    if options:
        argv += ["-o", ",".join(options)]
    run(argv)


def layer(entry, name, cipher, target, key):
    fmt = entry["encryption"].get("format")
    if fmt == CC_STORAGE_FORMAT:
        argv = [tool("bai-storage-fuse"), "-allow-other"]
    elif fmt == "gocryptfs":
        argv = [tool("gocryptfs"), "-masterkey", "stdin", *GOCRYPTFS_FLAGS]
        shim_fusermount()
    else:
        raise Refusal(
            f"folder {name} is written in {fmt!r},"
            " for which this measured image carries no reader"
        )
    if entry.get("read_only"):
        argv.append("-ro")
    run([*argv, str(cipher), str(target)], key.hex().encode() + b"\n")


def mount_folder(api, scope, entry):
    name = entry["name"]
    descriptor = entry.get("encryption")
    if not descriptor:
        raise Refusal(f"folder {name} arrived without an encryption descriptor")
    node("/dev/fuse", 10, 229)
    key = released_key(api, scope, descriptor, f"folder {name}")
    cipher = STAGING / name
    cipher.mkdir(mode=0o700, parents=True, exist_ok=True)
    transport(entry, cipher)
    target = pathlib.Path(entry["target"])
    target.mkdir(mode=0o755, parents=True, exist_ok=True)
    layer(entry, name, cipher, target, key)


def prime(mapped, plan):
    marker = "Superblock backups stored on blocks:"
    blocks = {0}
    if marker in plan:
        blocks.update(int(token) for token in re.findall(r"\d+", plan.split(marker, 1)[1]))
    zeroes = mmap.mmap(-1, BLOCK)
    handle = os.open(mapped, os.O_WRONLY | os.O_DIRECT)
    try:
        for block in sorted(blocks):
            os.pwrite(handle, zeroes, block * BLOCK)
    finally:
        os.close(handle)


def open_scratch(api, scope, scratch):
    device = scratch["device"]
    if not pathlib.Path(device).exists():
        raise Refusal(f"the session scratch device {device} was never attached")
    node("/dev/mapper/control", 10, 236)
    key = released_key(api, scope, scratch, "session scratch")
    cryptsetup = tool("cryptsetup")
    keyed = ["--batch-mode", "--key-file", "-", "--keyfile-size", "32"]
    run([cryptsetup, "luksFormat", "--type", "luks2", "--cipher", "aes-xts-plain64",
         "--sector-size", str(BLOCK), "--integrity", "hmac-sha256", "--integrity-no-wipe",
         "--integrity-no-journal", *keyed, device], key)
    run([cryptsetup, "open", *keyed, device, MAPPER], key)
    mapped = f"/dev/mapper/{MAPPER}"
    mkfs = tool("mkfs.ext4")
    prime(mapped, run([mkfs, "-F", "-n", mapped]))
    run([mkfs, "-q", "-F", "-E", "nodiscard,lazy_itable_init=0", mapped])
    target = pathlib.Path(scratch["target"])
    target.mkdir(mode=0o755, parents=True, exist_ok=True)
    kmount(f"/dev/mapper/{MAPPER}", target, "ext4", 0)
    os.chmod(target, 0o755)
    os.chown(target, int(os.environ.get("LOCAL_USER_ID") or 9001),
             int(os.environ.get("LOCAL_GROUP_ID") or 9001))


def starve(reason):
    note(f"backend.ai confidential kernel refuses its storage: {reason}")
    while True:
        time.sleep(3600)


def main():
    if not (STATE / "ready").is_file():
        raise Refusal("the guest never established attested wall-clock time")
    if not LOADER.is_file():
        raise Refusal(f"the measured guest toolchain was not delivered under {GUEST}")
    api = json.loads((STATE / "profile.json").read_text())["api"]
    resource = os.environ.get("BACKENDAI_CC_MOUNT_PLAN_URI")
    if not resource:
        raise Refusal("no mount plan resource was named for this kernel")
    scope = resource.rsplit("/", 1)[0]
    plan = json.loads(fetch(api, resource))
    if plan.get("version") != 1:
        raise Refusal(f"the mount plan claims version {plan.get('version')!r}")
    STAGING.mkdir(mode=0o700, exist_ok=True)
    if plan.get("scratch"):
        open_scratch(api, scope, plan["scratch"])
    for entry in plan.get("mounts", []):
        mount_folder(api, scope, entry)


try:
    main()
except Refusal as refusal:
    starve(refusal)
