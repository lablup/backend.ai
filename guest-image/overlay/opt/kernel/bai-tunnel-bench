#!/opt/backend.ai/bin/python
import ipaddress
import json
import os
import pathlib
import socket
import sys
import time
import urllib.request

STATE = pathlib.Path("/run/backend.ai")
SHARED = STATE / "session"
PORT = 47820
CHUNK = 4 << 20
VOLUME = 512 << 20


def fetch(api, resource):
    with urllib.request.urlopen(f"{api}/cdh/resource/{resource}", timeout=60) as response:
        return json.loads(response.read())


def membership():
    request = json.loads((SHARED / "tunnel.json").read_text())
    api = json.loads((STATE / "profile.json").read_text())["api"]
    own = fetch(api, request["tunnel"])
    directory = fetch(api, request["peers"])
    return own["cluster_idx"], directory["peers"]


def carrier():
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    with probe:
        probe.connect(("192.0.2.1", 9))
        return ipaddress.ip_address(probe.getsockname()[0])


def endpoints(peer_idx):
    own_idx, peers = membership()
    peer = next((p for p in peers if p["cluster_idx"] == peer_idx), None)
    if peer is None:
        raise SystemExit(f"the signed peer directory carries no member {peer_idx}")
    return {
        "bridge": str(carrier() - own_idx + peer_idx),
        "tunnel": peer["tunnel_addr"],
    }


def serve():
    listener = socket.socket()
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("", PORT))
    listener.listen(4)
    view = memoryview(bytearray(CHUNK))
    while True:
        conn, _ = listener.accept()
        with conn:
            while conn.recv_into(view, CHUNK):
                pass


def blast(host):
    payload = os.urandom(CHUNK)
    conn = socket.create_connection((host, PORT), timeout=30)
    started = time.perf_counter()
    with conn:
        for _ in range(VOLUME // CHUNK):
            conn.sendall(payload)
    return VOLUME / (time.perf_counter() - started) / (1 << 20)


def throughput(peer_idx):
    result = {}
    for name, host in endpoints(peer_idx).items():
        try:
            result[name] = blast(host)
        except OSError as refusal:
            result[name] = f"{host}: {type(refusal).__name__}: {refusal}"
    if all(isinstance(rate, float) for rate in result.values()):
        result["cipher_cost"] = 1.0 - result["tunnel"] / result["bridge"]
    print(json.dumps(result, indent=2))


def allreduce(master, elements):
    import torch
    import torch.distributed as dist

    own_idx, peers = membership()
    os.environ["MASTER_ADDR"] = master
    os.environ["MASTER_PORT"] = str(PORT + 1)
    os.environ["RANK"] = str(own_idx - 1)
    os.environ["WORLD_SIZE"] = str(len(peers))
    dist.init_process_group("gloo")
    tensor = torch.ones(elements)
    dist.all_reduce(tensor)
    dist.barrier()
    started = time.perf_counter()
    for _ in range(20):
        dist.all_reduce(tensor)
    elapsed = (time.perf_counter() - started) / 20
    if dist.get_rank() == 0:
        print(json.dumps({"master": master, "elements": elements, "seconds": elapsed}, indent=2))
    dist.destroy_process_group()


if sys.argv[1:2] == ["serve"]:
    serve()
elif sys.argv[1:2] == ["throughput"]:
    throughput(int(sys.argv[2]))
elif sys.argv[1:2] == ["allreduce"]:
    allreduce(sys.argv[2], int(sys.argv[3]) if sys.argv[3:] else 64 << 20)
else:
    print(
        "usage: bai-tunnel-bench serve"
        " | throughput <peer member index>"
        " | allreduce <master address> [elements]",
        file=sys.stderr,
    )
    sys.exit(2)
