#!/opt/backend.ai/bin/python
import hashlib
import hmac
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.request

STATE = pathlib.Path("/run/backend.ai")
KEYS = STATE / "integrity-keys"
REQUIRED = ("folder", "name", "image", "target", "key_resource", "lease_resource",
            "holder", "sector_size", "tag_size", "integrity_algorithm", "journal", "cipher")


class Refusal(Exception):
    pass


def profile():
    try:
        return json.loads((STATE / "profile.json").read_text())
    except OSError:
        raise Refusal("the guest boot gate has published no local endpoint")


def fetch(api, resource, timeout=20):
    try:
        with urllib.request.urlopen(f"{api}/cdh/resource/{resource}", timeout=timeout) as answer:
            body = answer.read()
    except Exception as failure:
        raise Refusal(f"{resource} was not released: {failure}")
    if not body:
        raise Refusal(f"{resource} released zero bytes")
    return body


def hkdf(secret, info, length):
    prk = hmac.new(b"backend.ai/cc-integrity-tier/v1", secret, hashlib.sha256).digest()
    out, block, counter = b"", b"", 1
    while len(out) < length:
        block = hmac.new(prk, block + info + bytes([counter]), hashlib.sha256).digest()
        out += block
        counter += 1
    return out[:length]


def run(argv, check=True):
    done = subprocess.run(argv, capture_output=True)
    if check and done.returncode != 0:
        raise Refusal(f"{' '.join(argv[:2])}: {done.stderr.decode().strip()}")
    return done


def keyfile(name, material):
    KEYS.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = KEYS / name
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as handle:
        handle.write(material)
    return str(path)


def superblock(loop):
    done = run(["integritysetup", "dump", loop], check=False)
    if done.returncode != 0:
        return None
    fields = {}
    for line in done.stdout.decode().splitlines():
        parts = line.split()
        if len(parts) == 2:
            fields[parts[0]] = parts[1]
    return fields


def disagreement(found, plan):
    if int(found.get("sector_size", 0)) != plan["sector_size"]:
        return "sector size"
    if int(found.get("integrity_tag_size", found.get("tag_size", 0))) != plan["tag_size"]:
        return "tag size"
    if plan["journal"] and int(found.get("journal_sections", 0)) == 0:
        return "journal mode"
    return None


def integrity_argv(plan, key):
    return ["--integrity", plan["integrity_algorithm"], "--integrity-key-file", key,
            "--integrity-key-size", "32"] + ([] if plan["journal"] else ["--integrity-no-journal"])


def attach(plan):
    argv = ["losetup", "--find", "--show", "--sector-size", str(plan["sector_size"])]
    if plan.get("direct_io", True):
        argv.append("--direct-io=on")
    return run(argv + [plan["image"]]).stdout.decode().strip()


def open_stack(plan, loop, auth_key, cipher_key):
    inner = plan["name"] + "-auth"
    run(["integritysetup", "open", loop, inner] + integrity_argv(plan, auth_key))
    run(["cryptsetup", "open", f"/dev/mapper/{inner}", plan["name"], "--type", "plain",
         "--cipher", plan["cipher"], "--key-size", str(plan["key_bits"]),
         "--sector-size", str(plan["sector_size"]), "--key-file", cipher_key])
    return inner


def grow(plan, inner):
    if run(["integritysetup", "resize", inner], check=False).returncode != 0:
        raise Refusal(f"{plan['folder']} grew on the export but its sector tags could not follow")
    run(["cryptsetup", "resize", plan["name"]])
    run(["resize2fs", f"/dev/mapper/{plan['name']}"], check=False)


def mismatches(inner):
    fields = run(["dmsetup", "status", inner], check=False).stdout.decode().split()
    for index, token in enumerate(fields):
        if token == "integrity" and index + 1 < len(fields):
            return int(fields[index + 1])
    return 0


def publish(plan, payload):
    (STATE / f"integrity-{plan['name']}.json").write_text(json.dumps(payload, sort_keys=True) + "\n")


def teardown(plan, loop=None):
    run(["umount", plan["target"]], check=False)
    run(["cryptsetup", "close", plan["name"]], check=False)
    run(["integritysetup", "close", plan["name"] + "-auth"], check=False)
    if loop is None:
        found = run(["losetup", "--associated", plan["image"], "-nO", "NAME"], check=False)
        loop = found.stdout.decode().strip().splitlines()
        loop = loop[0] if loop else None
    if loop:
        run(["losetup", "--detach", loop], check=False)


def lease_expiry(api, plan):
    lease = json.loads(fetch(api, plan["lease_resource"]))
    if lease["holder"] != plan["holder"]:
        raise Refusal(f"the mount lease on {plan['folder']} now belongs to {lease['holder']}")
    return int(lease["expires_at"])


def opened(api, plan):
    if not (STATE / "ready").is_file():
        raise Refusal("the guest clock is not anchored to an attested source")
    expires_at = lease_expiry(api, plan)
    if time.time() >= expires_at:
        raise Refusal(f"the mount lease on {plan['folder']} has already elapsed")
    material = fetch(api, plan["key_resource"])
    auth_key = keyfile(plan["name"] + ".auth", hkdf(material, b"sector-tag", 32))
    cipher_key = keyfile(plan["name"] + ".enc", hkdf(material, b"sector-cipher", plan["key_bits"] // 8))
    loop = attach(plan)
    try:
        found = superblock(loop)
        if found is None:
            run(["integritysetup", "format", loop, "--batch-mode", "--tag-size",
                 str(plan["tag_size"]), "--sector-size", str(plan["sector_size"])]
                + integrity_argv(plan, auth_key))
        elif differs := disagreement(found, plan):
            raise Refusal(f"{plan['image']} was formatted with a {differs}"
                          " the mount plan does not name")
        inner = open_stack(plan, loop, auth_key, cipher_key)
        os.unlink(auth_key)
        os.unlink(cipher_key)
        if found is None:
            run(["mkfs.ext4", "-q", "-F", "-L", "bai-integrity", f"/dev/mapper/{plan['name']}"])
        else:
            grow(plan, inner)
        pathlib.Path(plan["target"]).mkdir(parents=True, exist_ok=True)
        run(["mount", "-o", "noatime", f"/dev/mapper/{plan['name']}", plan["target"]])
    except Exception:
        for spent in (auth_key, cipher_key):
            pathlib.Path(spent).unlink(missing_ok=True)
        teardown(plan, loop)
        raise
    publish(plan, {"state": "mounted", "expires_at": expires_at, "formatted": found is None})
    return expires_at


def watch(api, plan):
    interval = float(plan.get("lease_poll", 60))
    inner, expires_at = plan["name"] + "-auth", lease_expiry(api, plan)
    while True:
        time.sleep(interval)
        seen = mismatches(inner)
        if seen:
            publish(plan, {"state": "tampered", "mismatches": seen})
            teardown(plan)
            raise Refusal(f"{seen} sectors of {plan['folder']} failed authentication")
        try:
            expires_at = lease_expiry(api, plan)
        except Refusal as failure:
            if time.time() < expires_at:
                publish(plan, {"state": "mounted", "expires_at": expires_at, "renewal": str(failure)})
                continue
            publish(plan, {"state": "fenced", "reason": str(failure)})
            teardown(plan)
            raise
        if time.time() >= expires_at:
            publish(plan, {"state": "fenced", "reason": "the mount lease term elapsed"})
            teardown(plan)
            raise Refusal(f"the mount lease on {plan['folder']} elapsed")
        publish(plan, {"state": "mounted", "expires_at": expires_at})


def main():
    verb, plan = sys.argv[1], json.loads(pathlib.Path(sys.argv[2]).read_text())
    plan.setdefault("key_bits", 512)
    for field in REQUIRED:
        if field not in plan:
            raise Refusal(f"the mount plan entry for {plan.get('folder')} names no {field}")
    if verb == "close":
        teardown(plan)
        publish(plan, {"state": "released"})
    elif verb == "watch":
        watch(profile()["api"], plan)
    else:
        opened(profile()["api"], plan)


try:
    main()
except Refusal as failure:
    print(f"backend.ai integrity tier: {failure}", file=sys.stderr)
    sys.exit(1)
