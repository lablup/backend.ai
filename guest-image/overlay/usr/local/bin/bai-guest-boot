#!/opt/backend.ai/bin/python
import base64
import ctypes
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import time
import tomllib
import urllib.request

INITDATA = pathlib.Path("/run/confidential-containers/initdata/initdata.toml")
STATE = pathlib.Path("/run/backend.ai")
P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF
N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
G = (
    0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,
    0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5,
)


class Starve(Exception):
    pass


def settings():
    if not INITDATA.is_file():
        raise Starve("no measured configuration blob in the guest")
    blob = tomllib.loads(INITDATA.read_text())
    try:
        return tomllib.loads(blob["data"]["backendai.toml"])
    except KeyError:
        raise Starve("measured configuration blob carries no backendai.toml")


def get(url, timeout=15):
    with urllib.request.urlopen(url, timeout=timeout) as response:
        return response.read()


def unpad(segment):
    return base64.urlsafe_b64decode(segment + "=" * (-len(segment) % 4))


def point_add(a, b):
    if a is None:
        return b
    if b is None:
        return a
    if a[0] == b[0]:
        if (a[1] + b[1]) % P == 0:
            return None
        slope = (3 * a[0] * a[0] - 3) * pow(2 * a[1], -1, P) % P
    else:
        slope = (b[1] - a[1]) * pow(b[0] - a[0], -1, P) % P
    x = (slope * slope - a[0] - b[0]) % P
    return (x, (slope * (a[0] - x) - a[1]) % P)


def point_mul(scalar, point):
    total = None
    while scalar:
        if scalar & 1:
            total = point_add(total, point)
        point = point_add(point, point)
        scalar >>= 1
    return total


def signed_by(pinned, message, signature):
    encoded = base64.b64decode(pinned)[-65:]
    if len(signature) != 64 or encoded[0] != 4:
        return False
    public = (int.from_bytes(encoded[1:33]), int.from_bytes(encoded[33:]))
    r = int.from_bytes(signature[:32])
    s = int.from_bytes(signature[32:])
    if not 0 < r < N or not 0 < s < N:
        return False
    inverse = pow(s, -1, N)
    digest = int.from_bytes(hashlib.sha256(message).digest())
    check = point_add(
        point_mul(digest * inverse % N, G), point_mul(r * inverse % N, public)
    )
    return check is not None and check[0] % N == r


def token_issued_at(cfg):
    body = json.loads(get(f"{cfg['api']}/aa/token?token_type=kbs"))
    header, claims, signature = body["token"].split(".")
    if json.loads(unpad(header)).get("alg") != "ES256":
        raise Starve("the attestation token is not signed with the pinned algorithm")
    if not signed_by(cfg["token_signing_key"], f"{header}.{claims}".encode(), unpad(signature)):
        raise Starve(
            "the attestation token does not carry the signature of the key broker this"
            " measured configuration pins, so the guest is not talking to its own broker"
        )
    return int(json.loads(unpad(claims))["iat"])


def attested_now(cfg):
    return token_issued_at(cfg), "attestation-token"


def set_realtime(epoch):
    libc = ctypes.CDLL("libc.so.6", use_errno=True)

    class Timespec(ctypes.Structure):
        _fields_ = [("tv_sec", ctypes.c_long), ("tv_nsec", ctypes.c_long)]

    if libc.clock_settime(0, ctypes.byref(Timespec(epoch, 0))) != 0:
        raise Starve(f"clock_settime refused: {os.strerror(ctypes.get_errno())}")


def publish(name, payload):
    path = STATE / name
    path.write_text(json.dumps(payload, sort_keys=True) + "\n")


def guest_identity():
    keydir = STATE / "ssh"
    keydir.mkdir(mode=0o700, exist_ok=True)
    key = keydir / "dropbear_rsa_host_key"
    if not key.exists():
        subprocess.run(
            ["/opt/kernel/dropbearmulti", "dropbearkey", "-t", "rsa", "-f", str(key)],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        key.chmod(0o600)


def discipline(cfg, anchor_real, anchor_mono, source):
    bound = float(cfg["time_skew_bound"])
    interval = float(cfg["time_reanchor_interval"])
    while True:
        time.sleep(interval)
        elapsed = time.clock_gettime(time.CLOCK_MONOTONIC_RAW) - anchor_mono
        local = anchor_real + elapsed
        drift = abs(time.time() - local)
        if drift > bound:
            raise Starve(f"wall clock diverged from the hardware counter by {drift:.1f}s")
        remote, source = attested_now(cfg)
        skew = abs(remote - local)
        if skew > bound:
            raise Starve(f"attested time differs from the disciplined clock by {skew:.1f}s")
        set_realtime(int(local))
        publish("time.json", {"state": "disciplined", "source": source, "skew": skew})


def main():
    STATE.mkdir(mode=0o755, exist_ok=True)
    (STATE / "session").mkdir(mode=0o755, exist_ok=True)
    cfg = settings()
    if not cfg.get("token_signing_key"):
        raise Starve("the measured configuration pins no key broker token signing key")
    epoch, source = attested_now(cfg)
    set_realtime(epoch)
    anchor_mono = time.clock_gettime(time.CLOCK_MONOTONIC_RAW)
    publish("time.json", {"state": "anchored", "source": source, "issued_at": epoch})
    guest_identity()
    publish("profile.json", {"api": cfg["api"], "allow_sudo": bool(cfg.get("allow_sudo", False))})
    (STATE / "ready").write_text("ready\n")
    discipline(cfg, epoch, anchor_mono, source)


try:
    main()
except Starve as failure:
    (STATE / "ready").unlink(missing_ok=True)
    publish("time.json", {"state": "failed", "reason": str(failure)})
    print(f"backend.ai confidential guest refuses to become ready: {failure}", file=sys.stderr)
    sys.exit(1)
