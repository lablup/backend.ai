[Unit]
Description=Backend.AI attested unlock of the state volume
DefaultDependencies=no
After=dracut-initqueue.service network-online.target
Wants=network-online.target
Before=initrd.target initrd-parse-etc.service
Conflicts=shutdown.target initrd-switch-root.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
ExecStart=/usr/bin/unlock-state-volume
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=initrd.target
