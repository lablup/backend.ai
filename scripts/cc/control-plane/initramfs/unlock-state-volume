#!/bin/sh
set -eu

for word in $(cat /proc/cmdline); do
    case "$word" in
    BACKENDAI_*=*) export "$word" ;;
    esac
done

DEVICE=${BACKENDAI_STATE_DEVICE:-/dev/disk/by-partlabel/backendai-state}
NAME=${BACKENDAI_STATE_NAME:-backendai-state}
URL=${BACKENDAI_KBS_URL:?BACKENDAI_KBS_URL is not set in the measured command line}
KEY_PATH=${BACKENDAI_KEY_PATH:-default/control-plane/state-disk-key}
MAC_PATH=${BACKENDAI_MAC_PATH:-default/control-plane/state-header-mac}
ATTEMPTS=${BACKENDAI_UNLOCK_ATTEMPTS:-5}
BACKOFF=${BACKENDAI_UNLOCK_BACKOFF:-5}
VERDICTS=${BACKENDAI_UNLOCK_VERDICTS:-/run/backendai-unlock.jsonl}
REFUSAL='PolicyDeny|denied|deny|not allowed|unauthorized|forbidden|403|401'
WORK=$(mktemp -d)
trap 'shred -u "$WORK"/* 2>/dev/null || true; rm -rf "$WORK"' EXIT

export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
modprobe tdx_guest 2>/dev/null || true
mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
for _ in $(seq 60); do
    ip route 2>/dev/null | grep -q '^default' && break
    sleep 1
done

verdict() {
    printf '{"at":%s,"clause":"%s","credential":"%s","unit":"backendai-unlock-state.service","verdict":"%s"}\n' \
        "$(date -u +%s)" "$2" "$3" "$1" >> "$VERDICTS" 2>/dev/null || true
}

fetch() {
    attempt=1
    while :; do
        if kbs-client --url "$URL" get-resource --path "$1" > "$WORK/wire" 2> "$WORK/why"; then
            if ! base64 -d < "$WORK/wire" > "$2"; then
                echo "unlock-state-volume: $1 released material that is not base64" >&2
                verdict refused "released material that is not base64" "$1"
                exit 78
            fi
            if [ ! -s "$2" ]; then
                echo "unlock-state-volume: $1 released zero bytes; refusing to unlock" >&2
                verdict refused "released zero bytes" "$1"
                exit 78
            fi
            [ "$attempt" -eq 1 ] || verdict recovered "reached the key broker on attempt ${attempt}" "$1"
            return 0
        fi
        if grep -Eqi "$REFUSAL" "$WORK/why"; then
            echo "unlock-state-volume: release refused for $1; the key broker answered and would not release" >&2
            grep -a 'error_type\|^Error' "$WORK/why" | sed 's/^/unlock-state-volume: refusal: /' >&2 || true
            verdict refused "the key broker answered and would not release" "$1"
            exit 78
        fi
        echo "unlock-state-volume: key broker unreachable for $1 on attempt ${attempt} of ${ATTEMPTS}" >&2
        grep -a '^Error' "$WORK/why" | sed 's/^/unlock-state-volume: outage: /' >&2 || true
        verdict unreachable "attempt ${attempt} of ${ATTEMPTS}" "$1"
        if [ "$attempt" -ge "$ATTEMPTS" ]; then
            echo "unlock-state-volume: key broker still unreachable after ${ATTEMPTS} attempts; this is an outage, not a refusal" >&2
            verdict outage "unreachable through all ${ATTEMPTS} attempts" "$1"
            exit 75
        fi
        sleep $((BACKOFF * attempt))
        attempt=$((attempt + 1))
    done
}

fetch "$KEY_PATH" "$WORK/key"
fetch "$MAC_PATH" "$WORK/expected"

cryptsetup luksHeaderBackup "$DEVICE" --header-backup-file "$WORK/header" -q
diskkey=$(od -An -v -tx1 < "$WORK/key" | tr -d ' \n')
mackey=$(printf 'backendai-luks-header-v1' | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${diskkey}" -r | cut -d' ' -f1)
actual=$(openssl dgst -sha256 -mac HMAC -macopt "hexkey:${mackey}" -r "$WORK/header" | cut -d' ' -f1)
expected=$(tr -d ' \n\r' < "$WORK/expected")

if [ "$actual" != "$expected" ]; then
    echo "unlock-state-volume: the encryption header does not authenticate" >&2
    echo "unlock-state-volume: expected ${expected}, computed ${actual}" >&2
    verdict refused "the encryption header does not authenticate" "$DEVICE"
    exit 78
fi

cryptsetup luksOpen --key-file "$WORK/key" "$DEVICE" "$NAME"
