#!/bin/sh
set -eu

if [ -z "${CREDENTIALS_DIRECTORY:-}" ]; then
    echo "credential-guard: no credentials directory; the broker socket was absent" >&2
    exit 78
fi

status=0
for name in "$@"; do
    path="${CREDENTIALS_DIRECTORY}/${name}"
    if [ ! -f "$path" ]; then
        echo "credential-guard: ${name} was not delivered" >&2
        status=78
    elif [ ! -s "$path" ]; then
        echo "credential-guard: ${name} is zero length; release was denied" >&2
        status=78
    fi
done

for path in "${CREDENTIALS_DIRECTORY}"/*; do
    [ -e "$path" ] || continue
    if [ ! -s "$path" ]; then
        echo "credential-guard: $(basename "$path") is zero length; release was denied" >&2
        status=78
    fi
done

exit $status
